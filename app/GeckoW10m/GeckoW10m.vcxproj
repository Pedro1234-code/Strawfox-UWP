    <ClCompile Include="engine\GeckoRuntimeHost.cpp" />
    <ClCompile Include="engine\gecko_capi_stub.cpp" Condition="'$(GeckoW10mUseEngineStub)'=='true'" />
    <CustomBuild Include="engine\gecko_bootstrap.cpp">
      <Command>"$(GeckoW10mClangCl)" --target=x86_64-pc-windows-msvc /nologo /c "%(FullPath)" /Fo:"$(IntDir)gecko_bootstrap_$(Configuration).obj" /std:c++20 /EHs-c- /GR- $(GeckoW10mBootstrapFlags) /Zl /utf-8 /DWIN32 /D_WIN32 /DWIN64 /DNOMINMAX /DUNICODE /D_UNICODE /DWINAPI_FAMILY=WINAPI_FAMILY_DESKTOP_APP /DXP_WIN /DGECKO_W10M=1 /I"$(GeckoW10mObj)\dist\include" /I"$(ProjectDir)..\..\engine\firefox\toolkit\components\startup"</Command>
      <Outputs>$(IntDir)gecko_bootstrap_$(Configuration).obj</Outputs>
      <AdditionalInputs>$(GeckoW10mObj)\dist\include\mozilla-config.h;%(AdditionalInputs)</AdditionalInputs>
      <Message>Compiling Gecko bootstrap with clang-cl</Message>
    </CustomBuild>
  </ItemGroup>
