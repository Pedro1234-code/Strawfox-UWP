    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(Configuration)'=='Release'">true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <!-- Link the engine stub by default; flip to the real Gecko import lib
         once tools/build-gecko-uwp.ps1 has produced it. -->
    <GeckoW10mUseEngineStub Condition="'$(GeckoW10mUseEngineStub)'==''">true</GeckoW10mUseEngineStub>
    <GeckoW10mObj Condition="'$(GeckoW10mObj)'==''">C:\rw-obj</GeckoW10mObj>
    <GeckoW10mClangCl Condition="'$(GeckoW10mClangCl)'==''">C:\Program Files\LLVM\bin\clang-cl.exe</GeckoW10mClangCl>
    <PackageCertificateThumbprint>2817415E0DFAC624BDB99EA60E7DE6BDFA1667ED</PackageCertificateThumbprint>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <GeckoW10mBootstrapFlags>/Od /MDd /D_DEBUG /D_ITERATOR_DEBUG_LEVEL=2</GeckoW10mBootstrapFlags>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'!='Debug'">
    <GeckoW10mBootstrapFlags>/O2 /MD /DNDEBUG /D_ITERATOR_DEBUG_LEVEL=0</GeckoW10mBootstrapFlags>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- C++/CX (/ZW) is incompatible with C++20, while the Windows
           SDK 26100 C++/WinRT headers require at least C++17. -->
      <LanguageStandard>stdcpp17</LanguageStandard>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <AdditionalIncludeDirectories>$(ProjectDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions Condition="'$(Platform)'=='x64'">GECKO_W10M;NOMINMAX;_CRT_SECURE_NO_WARNINGS;_SILENCE_EXPERIMENTAL_COROUTINE_DEPRECATION_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(GeckoW10mUseEngineStub)'=='true'">GECKO_W10M_USE_ENGINE_STUB;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <!-- The codeGeneration capability + FromApp allocators are what enable
           JIT; nothing extra is needed at link time for the stub build. -->
      <AdditionalLibraryDirectories>$(GeckoW10mObj)\dist\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>mozglue.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
