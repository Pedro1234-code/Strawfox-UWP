  <!-- Package the complete Gecko runtime produced by browser-build.sh. -->
  <ItemGroup>
    <Content Include="$(GeckoW10mObj)\dist\bin\**\*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The bootstrap starts Gecko with browser/ as its application dir. -->
    <Content Include="$(GeckoW10mObj)\dist\bin\application.ini">
      <Link>browser\application.ini</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <None Include="CoreShellDevelopment.pfx" />
  </ItemGroup>
  <!-- mozglue.dll is built with the desktop VC runtime and is loaded before
       wWinMain.  Deploy that framework alongside the normal UWP VC runtime,
       otherwise an Xbox without the desktop redistributable cannot start the
       process at all. -->
