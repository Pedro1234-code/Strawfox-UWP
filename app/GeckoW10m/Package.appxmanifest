<?xml version="1.0" encoding="utf-8"?>
<!--
  Gecko for Windows 10 Mobile.

  The two things that make the Gecko port possible are declared here:

    * rescap:codeGeneration  -> unlocks VirtualAllocFromApp / VirtualProtectFromApp
                                with executable page protections, i.e. JIT.
    Downloads do not escape the app-container jail directly. Gecko writes to
    LocalState and the shell exports completed files through a FolderPicker
    permission persisted in the FutureAccessList.

  Restricted capabilities normally require Store approval. On an interop-unlocked
  device they are honoured for a sideloaded, self/interop-signed package.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
    xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap uap3 mp rescap">

  <!--
    Version: <Gecko major>.<port release>.<port fix>.<build>

    The first three are set by hand and mean something: the engine this was
    built from, the release of the port, and the fix within it. The fourth is
    a counter the build script increments on every single build and never
    resets, so no two packages ever carry the same number, installing over an
    older one always works, and the line the shell writes at the top of the
    log names exactly one package. See tools/build-appx.sh and
    app/GeckoW10m/build-number.txt.
  -->
  <Identity
      Name="Microsoft.MicrosoftEdge.Gecko"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US"
      Version="155.0.8.140"
      ProcessorArchitecture="x64" />

  <mp:PhoneIdentity
      PhoneProductId="1c42dda2-b778-4032-9f94-8f852c3ad652"
      PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Strawfox</DisplayName>
    <PublisherDisplayName>Computershik</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal"
                        MinVersion="10.0.26100.0"
                        MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="ru-RU" />
  </Resources>

  <Applications>
    <Application Id="App"
                 Executable="GeckoW10m.exe"
                 EntryPoint="Gecko.App">
      <uap:VisualElements
          DisplayName="Strawfox Browser"
          Description="Gecko based web browser for UWP."
          BackgroundColor="#1C1B22"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
            ShortName="Strawfox"
            Square71x71Logo="Assets\Square71x71Logo.png"
            Square310x310Logo="Assets\Square310x310Logo.png"
            Wide310x150Logo="Assets\Wide310x150Logo.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
            <uap:ShowOn Tile="square310x310Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#1C1B22" />
      </uap:VisualElements>

      <Extensions>
        <!--
          What makes the phone offer Gecko under Settings > System >
          Default apps > Web browser: an app registered for both http and
          https, with a name and an icon to show there. The app is then
          activated with the URL, which App::OnActivated passes to the engine.
        -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="http">
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:DisplayName>Gecko</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="https">
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:DisplayName>Gecko</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="gecko">
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:DisplayName>Gecko</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>

        <!-- Local pages, so "open with" offers the browser for them too. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="geckoweb">
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:DisplayName>Web page</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.html</uap:FileType>
              <uap:FileType>.htm</uap:FileType>
              <uap:FileType>.xhtml</uap:FileType>
              <uap:FileType>.svg</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <uap:Capability Name="picturesLibrary" />

    <!-- JIT. The whole reason a real Gecko engine can run here. -->
    <rescap:Capability Name="codeGeneration" />

    <!-- Camera / mic / location are brokered through the shell for getUserMedia. -->
    <DeviceCapability Name="microphone" />
    <DeviceCapability Name="webcam" />
    <DeviceCapability Name="location" />
  </Capabilities>
</Package>
